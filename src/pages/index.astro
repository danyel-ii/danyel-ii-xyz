                <g fill="none" stroke="currentColor" stroke-linecap="round">
                  <path d="M44 77 19 46M58 65 51 27M74 64 78 31M96 69l20-32M116 82l30-21M128 101l36-4M128 123l34 13M110 143l22 31M89 151l7 38M57 145l-14 32M39 129l-28 19M31 108 4 111" stroke-width="1.4" />
                  <path d="M787 84l-26-35M803 71l-14-39M822 64l-2-43M846 69l15-42M866 81l28-35M883 97l40-21M894 119l43-1M890 141l40 15M877 159l29 32M857 171l13 41M831 174l-5 42M806 162l-24 34M787 146l-38 22M776 124l-42 4M779 102l-38-15" stroke-width="1.25" />
                  <path d="M700 48l-21-3M711 31l-8-15M732 30l8-17M744 50l19-4M785 48l-19-4M797 30l-8-16M821 30l10-17M835 50l20-5" stroke-width="1.1" />
                </g>

                <g>
                  <circle cx="13" cy="62" r="2.2" />
                  <circle cx="27" cy="48" r="1.15" />
                  <circle cx="37" cy="25" r="2.6" />
                  <circle cx="67" cy="18" r="1.5" />
                  <circle cx="84" cy="4" r="2" />
                  <circle cx="111" cy="25" r="1.1" />
                  <circle cx="126" cy="44" r="3" />
                  <circle cx="151" cy="61" r="1.6" />
                  <circle cx="162" cy="94" r="2.4" />
                  <circle cx="153" cy="116" r="1.1" />
                  <circle cx="146" cy="150" r="2.2" />
