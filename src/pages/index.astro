---
import { socialLinks } from '../data/social'
import { siteMeta } from '../data/site'

import '../styles/global.scss'

const publicLinks = socialLinks.filter((link) => link.id !== 'rss')
const email = socialLinks.find((link) => link.id === 'email')
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>danyel-ii</title>
    <meta name="description" content="Contact and social links for danyel-ii." />
    <link rel="canonical" href={`https://${siteMeta.domain}/`} />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#050505" />
  </head>
  <body>
    <div class="construction-ribbon construction-ribbon--top" aria-label="Under construction notice">
      <span>UNDER CONSTRUCTION</span>
      <span>UNDER CONSTRUCTION</span>
      <span>UNDER CONSTRUCTION</span>
    </div>
    <div class="construction-ribbon construction-ribbon--bottom" aria-hidden="true">
      <span>UNDER CONSTRUCTION</span>
      <span>SITE IN PROGRESS</span>
      <span>UNDER CONSTRUCTION</span>
      <span>SITE IN PROGRESS</span>
      <span>UNDER CONSTRUCTION</span>
    </div>

    <main class="public-home" aria-labelledby="home-title">
      <section class="public-home__panel">
        <div class="public-home__top">
          <p class="public-home__eyebrow">public node</p>
          <button class="public-home__toggle js-banner-toggle" type="button" aria-label="Toggle construction banners">
            banners
          </button>
        </div>

        <div class="public-home__identity">
          <h1 id="home-title">danyel-ii</h1>
          {email && <a class="public-home__email" href={email.href}>{email.value}</a>}
        </div>

        <nav class="public-home__links" aria-label="Contact and social links">
          {publicLinks.map((link) => (
            <a href={link.href} target={link.href.startsWith('http') ? '_blank' : undefined} rel={link.href.startsWith('http') ? 'noreferrer' : undefined}>
              <span>{link.label}</span>
              <strong>{link.value}</strong>
            </a>
          ))}
        </nav>
      </section>
    </main>

    <script>
      const button = document.querySelector('.js-banner-toggle')

      if (button instanceof HTMLButtonElement) {
        const root = document.documentElement
        const storageKey = 'danyel-ii-banners'

        const applyState = (state) => {
          root.classList.toggle('construction-hidden', state === 'hidden')
          button.setAttribute('aria-pressed', state === 'hidden' ? 'true' : 'false')
          button.textContent = state === 'hidden' ? 'show banners' : 'hide banners'
        }

        applyState(localStorage.getItem(storageKey) ?? 'visible')

        button.addEventListener('click', () => {
          const next = root.classList.contains('construction-hidden') ? 'visible' : 'hidden'
          applyState(next)
          localStorage.setItem(storageKey, next)
        })
      }
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 18% 18%, rgba(246, 216, 96, 0.12), transparent 28rem),
      radial-gradient(circle at 82% 72%, rgba(133, 245, 222, 0.08), transparent 24rem),
      #050505;
  }

  .public-home {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 92px 18px;
  }

  .public-home__panel {
    display: grid;
    width: min(100%, 720px);
    gap: clamp(28px, 5vw, 48px);
  }

  .public-home__top,
  .public-home__links a {
    font-family: var(--mono-font);
  }

  .public-home__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .public-home__eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .public-home__toggle {
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    cursor: pointer;
    padding: 0 13px;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .public-home__identity {
    display: grid;
    gap: 14px;
  }

  .public-home h1 {
    margin: 0;
    color: var(--text);
    font-family: var(--display-font);
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 400;
    letter-spacing: -0.03em;
    line-height: 0.86;
  }

  .public-home__email {
    width: fit-content;
    color: var(--text-muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .public-home__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .public-home__links a {
    display: grid;
    gap: 8px;
    min-height: 94px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    padding: 16px;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .public-home__links a:hover {
    border-color: rgba(246, 216, 96, 0.58);
    background: rgba(246, 216, 96, 0.07);
    transform: translateY(-2px);
  }

  .public-home__links span {
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .public-home__links strong {
    overflow-wrap: anywhere;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.35;
  }

  @media (max-width: 680px) {
    .public-home {
      align-items: center;
      padding: 78px 14px;
    }

    .public-home__panel {
      gap: 30px;
    }

    .public-home__links {
      grid-template-columns: 1fr;
    }

    .public-home__links a {
      min-height: 78px;
    }
  }
</style>
