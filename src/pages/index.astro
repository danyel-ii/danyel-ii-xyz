                  <ellipse cx="24" cy="89" rx="3.4" ry="1.8" />

                  <circle cx="687" cy="26" r="1.5" />
                  <circle cx="699" cy="15" r="2.4" />
                  <circle cx="713" cy="5" r="1.1" />
                  <circle cx="738" cy="11" r="2.6" />
                  <circle cx="750" cy="29" r="1.4" />
                  <circle cx="765" cy="49" r="2" />
                  <circle cx="777" cy="20" r="1.4" />
                  <circle cx="793" cy="7" r="2.3" />
                  <circle cx="826" cy="6" r="1.2" />
                  <circle cx="842" cy="28" r="2.7" />
                  <circle cx="858" cy="47" r="1.45" />

                  <circle cx="745" cy="67" r="2.5" />
                  <circle cx="763" cy="79" r="1.2" />
                  <circle cx="771" cy="55" r="1.8" />
                  <circle cx="786" cy="39" r="3" />
                  <circle cx="811" cy="22" r="1.5" />
                  <circle cx="836" cy="31" r="2.15" />
                  <circle cx="866" cy="39" r="1.2" />
                  <circle cx="883" cy="54" r="3.2" />
                  <circle cx="907" cy="67" r="1.5" />
                  <circle cx="922" cy="91" r="2.5" />
                  <circle cx="933" cy="116" r="1.1" />
                  <circle cx="920" cy="139" r="3" />
                  <circle cx="908" cy="165" r="1.3" />
                  <circle cx="890" cy="181" r="2.4" />
                  <circle cx="875" cy="204" r="1.15" />
                  <circle cx="853" cy="191" r="2.8" />
                  <circle cx="826" cy="201" r="1.35" />
                  <circle cx="803" cy="188" r="2.4" />
                  <circle cx="780" cy="178" r="1.1" />
                  <circle cx="762" cy="161" r="3" />
                  <circle cx="742" cy="145" r="1.4" />
                  <circle cx="748" cy="119" r="2.2" />
                  <circle cx="735" cy="99" r="1.15" />
                  <ellipse cx="897" cy="104" rx="3.8" ry="1.9" />
                  <ellipse cx="791" cy="70" rx="1.7" ry="3.4" />
                </g>
              </g>
            </svg>
            <h1 id="home-title">danyel-ii</h1>
          </div>
          {email && <a class="public-home__email" href={email.href}>{email.value}</a>}
        </div>

        <ul class="public-home__links" aria-label="Contact details">
          {publicLinks.map((link, index) => (
            <li>
              <a
                class="public-home__link js-copy-contact"
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                data-copy-value={link.href.startsWith('mailto:') ? link.value : link.href}
                data-copy-label={link.label}
                aria-label={`${link.label}: ${link.value}. Copies ${link.href.startsWith('mailto:') ? 'address' : 'link'} and opens ${link.href.startsWith('http') ? 'in a new tab' : 'destination'}.`}
              >
                <span class="public-home__link-heading">
                  <span class="public-home__link-label">{link.label}</span>
                  <span class="public-home__copy-state" aria-hidden="true">copy + open</span>
                </span>
                <span class="public-home__value">
                  <strong>{link.value}</strong>
                  <svg
                    class="contact-scribble"
                    style={`--scribble-tilt: ${scribbles[index % scribbles.length].tilt}`}
                    viewBox="0 0 100 34"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    {scribbles[index % scribbles.length].paths.map((path) => (
                      <path d={path} vector-effect="non-scaling-stroke" />
                    ))}
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="u-sr-only js-copy-status" aria-live="polite"></p>
      </section>
    </main>

    <script>
      const button = document.querySelector('.js-banner-toggle')
      const contactLinks = document.querySelectorAll('.js-copy-contact')
      const copyStatus = document.querySelector('.js-copy-status')
      const feedbackTimers = new WeakMap()

      const writeToClipboard = async (value) => {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value)
          return
        }

        const fallback = document.createElement('textarea')
        fallback.value = value
        fallback.setAttribute('readonly', '')
        fallback.style.position = 'fixed'
        fallback.style.opacity = '0'
        fallback.style.pointerEvents = 'none'
        document.body.append(fallback)
        fallback.select()

        const copied = document.execCommand('copy')
        fallback.remove()

        if (!copied) throw new Error('Clipboard copy failed')
      }

      const setCopyFeedback = (contactLink, state) => {
        const previousTimer = feedbackTimers.get(contactLink)
        if (previousTimer) window.clearTimeout(previousTimer)

        const stateLabel = contactLink.querySelector('.public-home__copy-state')
        const label = contactLink.dataset.copyLabel ?? 'Contact detail'

        contactLink.dataset.copyState = state
        if (stateLabel) stateLabel.textContent = state === 'copied' ? 'copied' : 'copy failed'
        if (copyStatus) {
          copyStatus.textContent = state === 'copied'
            ? `${label} copied to clipboard.`
            : `${label} could not be copied.`
        }

        const timer = window.setTimeout(() => {
          delete contactLink.dataset.copyState
          if (stateLabel) stateLabel.textContent = 'copy + open'
        }, 1800)

        feedbackTimers.set(contactLink, timer)
      }

      contactLinks.forEach((contactLink) => {
        if (!(contactLink instanceof HTMLAnchorElement)) return

        contactLink.addEventListener('click', () => {
          const value = contactLink.dataset.copyValue
          if (!value) return

          void writeToClipboard(value)
            .then(() => setCopyFeedback(contactLink, 'copied'))
            .catch((error) => {
              console.error('Contact link copy failed', error)
              setCopyFeedback(contactLink, 'error')
            })
        })
      })

      if (button instanceof HTMLButtonElement) {
        const root = document.documentElement
        const storageKey = 'danyel-ii-banners'

        const applyState = (state) => {
          root.classList.toggle('construction-hidden', state === 'hidden')
          button.setAttribute('aria-pressed', state === 'hidden' ? 'true' : 'false')
          button.textContent = state === 'hidden' ? 'show banners' : 'hide banners'
        }

        applyState(localStorage.getItem(storageKey) ?? 'visible')

        button.addEventListener('click', () => {
          const next = root.classList.contains('construction-hidden') ? 'visible' : 'hidden'
          applyState(next)
          localStorage.setItem(storageKey, next)
        })
      }
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 18% 18%, rgba(246, 216, 96, 0.12), transparent 28rem),
      radial-gradient(circle at 82% 72%, rgba(133, 245, 222, 0.08), transparent 24rem),
      #050505;
  }

  .public-home {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 92px 18px;
  }

  .public-home__panel {
    display: grid;
    width: min(100%, 720px);
    gap: clamp(28px, 5vw, 48px);
    isolation: isolate;
  }

  .public-home__top,
  .public-home__link {
    font-family: var(--mono-font);
  }

  .public-home__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .public-home__eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .public-home__toggle {
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    cursor: pointer;
    padding: 0 13px;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .public-home__identity {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .public-home__title-paint {
    position: relative;
    display: inline-grid;
    width: fit-content;
    max-width: 100%;
    margin-bottom: clamp(16px, 2vw, 24px);
    color: #fff8dc;
    isolation: isolate;
  }

  .public-home__title-art {
    position: absolute;
    z-index: 0;
    top: -30%;
    left: -4%;
    width: 108%;
    height: auto;
    aspect-ratio: 900 / 360;
    overflow: visible;
    color: #f6d860;
    pointer-events: none;
  }

  :global(html.construction-hidden) .public-home__title-paint {
    color: #fff8dc;
    margin-bottom: 0;
  }

  :global(html.construction-hidden) .public-home__title-art {
    display: none;
  }

  .public-home h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: inherit;
    font-family: var(--mono-font);
    font-size: clamp(3.6rem, 9.5vw, 7.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-shadow: 0 14px 48px rgba(0, 0, 0, 0.9);
  }

  :global(html.construction-hidden) .public-home h1 {
    text-shadow:
      0 0 1px rgba(255, 255, 255, 0.95),
      0 0 30px rgba(246, 216, 96, 0.36),
      0 14px 48px rgba(0, 0, 0, 0.9);
  }

  .public-home__email {
    position: relative;
    z-index: 2;
    width: fit-content;
    color: #d9d0b7;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .public-home__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .public-home__links li {
    min-width: 0;
  }

  .public-home__link {
    display: grid;
    width: 100%;
    height: 100%;
    gap: 8px;
    align-content: center;
    justify-items: start;
    min-height: 94px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    color: inherit;
    cursor: pointer;
    text-align: left;
    padding: 16px;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .public-home__link:hover,
  .public-home__link:focus-visible {
    border-color: rgba(246, 216, 96, 0.58);
    background: rgba(246, 216, 96, 0.07);
    transform: translateY(-2px);
  }

  .public-home__link-heading {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .public-home__link-label {
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .public-home__copy-state {
    color: var(--yellow);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    opacity: 0;
    text-transform: uppercase;
    transition: opacity 160ms ease;
  }

  .public-home__link:hover .public-home__copy-state,
  .public-home__link:focus-visible .public-home__copy-state,
  .public-home__link[data-copy-state] .public-home__copy-state {
    opacity: 0.82;
  }

  .public-home__value {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }

  .public-home__value strong {
    overflow-wrap: anywhere;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .contact-scribble {
    position: absolute;
    top: 50%;
    left: -10px;
    width: calc(100% + 20px);
    height: 2.45rem;
    overflow: visible;
    pointer-events: none;
    transform: translateY(-50%) rotate(var(--scribble-tilt));
    transform-origin: center;
    opacity: 0.98;
    filter: drop-shadow(0 0 3px rgba(246, 216, 96, 0.28));
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .contact-scribble path {
    fill: none;
    stroke: #f6d860;
    stroke-width: 2.94;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .public-home__link:hover .contact-scribble,
  .public-home__link:focus-visible .contact-scribble,
  .public-home__link[data-copy-state] .contact-scribble,
  :global(html.construction-hidden) .contact-scribble {
    opacity: 0;
    transform: translateY(-50%) rotate(var(--scribble-tilt)) scaleX(0.96);
  }

  :global(html.construction-hidden) .contact-scribble {
    visibility: hidden;
  }

  @media (max-width: 680px) {
    .public-home {
      align-items: center;
