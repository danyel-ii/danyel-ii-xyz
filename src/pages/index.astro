---
export const prerender = false
import { socialLinks } from '../data/social'
import { siteMeta } from '../data/site'

import '../styles/global.scss'

const publicLinks = socialLinks.filter((link) => link.id !== 'rss')
const email = socialLinks.find((link) => link.id === 'email')

const scribbles = [
  {
    tilt: '-1.5deg',
    paths: [
      'M2 20 C9 19 14 5 22 8 C31 12 18 28 31 22 C40 18 39 5 47 8 C56 11 46 27 57 23 C66 19 65 8 74 9 C83 11 75 24 87 19 C92 16 96 13 99 15',
      'M4 26 L22 10 L15 27 L36 7 L29 28 L50 10 L43 27 L65 8 L57 26 L79 11 L71 25 L98 9',
    ],
  },
  {
    tilt: '1deg',
    paths: [
      'M2 25 L17 7 L13 27 L32 11 L25 29 L45 8 L40 27 L61 12 L55 28 L77 7 L72 26 L91 13 L88 27 L99 17',
      'M2 12 C14 20 25 27 37 18 C48 9 53 6 64 18 C75 30 84 20 98 11',
      'M4 21 C18 13 30 14 43 23 C57 31 71 20 82 14 C90 10 95 16 99 20',
    ],
  },
  {
    tilt: '-0.4deg',
    paths: [
      'M1 18 C13 18 25 15 37 18 C49 22 60 27 72 22 C84 17 91 12 99 16',
      'M1 24 C13 28 25 28 38 24 C51 20 63 13 76 18 C88 22 94 27 99 25',
      'M4 27 L24 10 L18 28 L45 12 L40 29 L68 10 L64 27 L95 14',
    ],
  },
  {
    tilt: '1.8deg',
    paths: [
      'M2 22 C11 12 21 8 29 15 C38 23 25 30 40 24 C51 19 49 7 59 12 C69 17 59 29 72 24 C82 20 84 11 92 14 C96 16 98 19 99 21',
      'M3 28 L25 9 L18 28 L45 12 L39 30 L64 8 L59 27 L84 11 L78 28 L99 15',
    ],
  },
  {
    tilt: '-2deg',
    paths: [
      'M1 14 C13 22 21 30 33 21 C44 13 49 4 61 15 C72 25 82 25 99 11',
      'M1 26 C15 18 26 11 38 20 C50 30 57 29 69 18 C80 9 90 17 99 23',
      'M4 29 L26 9 L20 29 L47 10 L42 28 L68 8 L63 27 L94 11',
    ],
  },
]
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>danyel-ii</title>
    <meta name="description" content="Contact and social links for danyel-ii." />
    <link rel="canonical" href={`https://${siteMeta.domain}/`} />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <link rel="icon" type="image/png" href="/icons/favicon-48x48.png" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#050505" />
  </head>
  <body>
    <div class="construction-ribbon construction-ribbon--top" aria-label="Under construction notice">
      <span>UNDER CONSTRUCTION</span>
      <span>UNDER CONSTRUCTION</span>
      <span>UNDER CONSTRUCTION</span>
    </div>
    <div class="construction-ribbon construction-ribbon--bottom" aria-hidden="true">
      <span>UNDER CONSTRUCTION</span>
      <span>SITE IN PROGRESS</span>
      <span>UNDER CONSTRUCTION</span>
      <span>SITE IN PROGRESS</span>
      <span>UNDER CONSTRUCTION</span>
    </div>

    <main class="public-home" aria-labelledby="home-title">
      <section class="public-home__panel">
        <div class="public-home__top">
          <p class="public-home__eyebrow">public node</p>
          <button class="public-home__toggle js-banner-toggle" type="button" aria-label="Toggle construction banners">
            banners
          </button>
        </div>

        <div class="public-home__identity">
          <div class="public-home__title-paint">
            <svg
              class="public-home__title-art"
              viewBox="0 0 900 265"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >
              <g fill="currentColor">
                <path d="M78 58c8 11 17 13 28 7l-1 17c12-4 24 3 27 14l17 1-13 12c5 12-2 25-14 30l3 17-17-9c-10 8-24 6-32-4l-14 12-3-18c-13-2-21-14-18-27l-18-6 17-9c0-13 10-23 23-24l5-17z" />
                <path d="M57 55 48 27l18 25zm-26 20L8 57l29 10zm-9 28L0 100l24 13zm15 31-24 15 29-7zm30 13-7 27 18-25zm48-88 8-27 4 31zm27 21 24-15-18 23zm-2 45 27 9-30 1z" />
                <circle cx="31" cy="47" r="4" />
                <circle cx="13" cy="82" r="2.8" />
                <circle cx="43" cy="163" r="3.3" />
                <circle cx="133" cy="48" r="3" />

                <path d="m724 39 5 11 12-4-4 12 10 7-13 2-2 13-7-11-12 5 4-12-10-7 13-1z" />
                <path d="m807 37 6 12 12-5-4 13 11 7-14 2-2 14-8-12-12 5 5-13-11-7 14-1z" />
                <circle cx="749" cy="40" r="2.8" />
                <circle cx="783" cy="53" r="2.2" />
                <circle cx="838" cy="43" r="3" />

                <path d="M819 78c10 9 19 10 29 3l4 17c13-2 25 6 27 19l17 6-15 10c3 13-5 25-18 28l-1 19-15-12c-11 7-25 3-31-8l-18 7 3-19c-11-6-15-20-8-31l-12-14 19-2c4-12 14-19 26-18z" />
                <path d="m799 83-13-24 21 19zm32-12 2-31 9 31zm35 17 21-19-14 26zm20 28 14-3-12 11zm-3 42 17 17-24-9zm-32 15 4 31-13-29zm-40-5-13 25 4-30z" />
                <circle cx="884" cy="92" r="3.5" />
                <circle cx="893" cy="145" r="2.4" />
                <circle cx="875" cy="187" r="3" />

                <path d="M79 143c10 0 15 8 13 21l-4 51c-1 12-10 12-11 0l-3-50c-1-12 0-19 5-22z" />
                <path d="M287 153c7-2 11 4 10 13l-2 27c-1 9-7 9-8 0l-3-26c-1-8 0-12 3-14z" />
                <path d="M486 146c8 1 11 8 9 21l-3 68c-1 12-8 12-9 0l-3-69c-1-11 1-18 6-20z" />
                <path d="M628 153c9-2 14 4 12 16l-3 42c-1 10-8 10-9 0l-4-41c-1-9 0-15 4-17z" />
                <path d="M831 147c10-2 16 6 15 19l-2 69c0 13-10 14-12 1l-6-68c-2-12 0-19 5-21z" />
                <circle cx="486" cy="253" r="4" />
                <circle cx="633" cy="228" r="3" />
                <circle cx="839" cy="254" r="4.5" />
              </g>
            </svg>
            <h1 id="home-title">danyel-ii</h1>
          </div>
          {email && <a class="public-home__email" href={email.href}>{email.value}</a>}
        </div>

        <ul class="public-home__links" aria-label="Contact details">
          {publicLinks.map((link, index) => (
            <li>
              <a
                class="public-home__link js-copy-contact"
                href={link.href}
                target={link.href.startsWith('http') ? '_blank' : undefined}
                rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
                data-copy-value={link.href.startsWith('mailto:') ? link.value : link.href}
                data-copy-label={link.label}
                aria-label={`${link.label}: ${link.value}. Copies ${link.href.startsWith('mailto:') ? 'address' : 'link'} and opens ${link.href.startsWith('http') ? 'in a new tab' : 'destination'}.`}
              >
                <span class="public-home__link-heading">
                  <span class="public-home__link-label">{link.label}</span>
                  <span class="public-home__copy-state" aria-hidden="true">copy + open</span>
                </span>
                <span class="public-home__value">
                  <strong>{link.value}</strong>
                  <svg
                    class="contact-scribble"
                    style={`--scribble-tilt: ${scribbles[index % scribbles.length].tilt}`}
                    viewBox="0 0 100 34"
                    preserveAspectRatio="none"
                    aria-hidden="true"
                    focusable="false"
                  >
                    {scribbles[index % scribbles.length].paths.map((path) => (
                      <path d={path} vector-effect="non-scaling-stroke" />
                    ))}
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="u-sr-only js-copy-status" aria-live="polite"></p>
      </section>
    </main>

    <script>
      const button = document.querySelector('.js-banner-toggle')
      const contactLinks = document.querySelectorAll('.js-copy-contact')
      const copyStatus = document.querySelector('.js-copy-status')
      const feedbackTimers = new WeakMap()

      const writeToClipboard = async (value) => {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value)
          return
        }

        const fallback = document.createElement('textarea')
        fallback.value = value
        fallback.setAttribute('readonly', '')
        fallback.style.position = 'fixed'
        fallback.style.opacity = '0'
        fallback.style.pointerEvents = 'none'
        document.body.append(fallback)
        fallback.select()

        const copied = document.execCommand('copy')
        fallback.remove()

        if (!copied) throw new Error('Clipboard copy failed')
      }

      const setCopyFeedback = (contactLink, state) => {
        const previousTimer = feedbackTimers.get(contactLink)
        if (previousTimer) window.clearTimeout(previousTimer)

        const stateLabel = contactLink.querySelector('.public-home__copy-state')
        const label = contactLink.dataset.copyLabel ?? 'Contact detail'

        contactLink.dataset.copyState = state
        if (stateLabel) stateLabel.textContent = state === 'copied' ? 'copied' : 'copy failed'
        if (copyStatus) {
          copyStatus.textContent = state === 'copied'
            ? `${label} copied to clipboard.`
            : `${label} could not be copied.`
        }

        const timer = window.setTimeout(() => {
          delete contactLink.dataset.copyState
          if (stateLabel) stateLabel.textContent = 'copy + open'
        }, 1800)

        feedbackTimers.set(contactLink, timer)
      }

      contactLinks.forEach((contactLink) => {
        if (!(contactLink instanceof HTMLAnchorElement)) return

        contactLink.addEventListener('click', () => {
          const value = contactLink.dataset.copyValue
          if (!value) return

          void writeToClipboard(value)
            .then(() => setCopyFeedback(contactLink, 'copied'))
            .catch((error) => {
              console.error('Contact link copy failed', error)
              setCopyFeedback(contactLink, 'error')
            })
        })
      })

      if (button instanceof HTMLButtonElement) {
        const root = document.documentElement
        const storageKey = 'danyel-ii-banners'

        const applyState = (state) => {
          root.classList.toggle('construction-hidden', state === 'hidden')
          button.setAttribute('aria-pressed', state === 'hidden' ? 'true' : 'false')
          button.textContent = state === 'hidden' ? 'show banners' : 'hide banners'
        }

        applyState(localStorage.getItem(storageKey) ?? 'visible')

        button.addEventListener('click', () => {
          const next = root.classList.contains('construction-hidden') ? 'visible' : 'hidden'
          applyState(next)
          localStorage.setItem(storageKey, next)
        })
      }
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100svh;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 18% 18%, rgba(246, 216, 96, 0.12), transparent 28rem),
      radial-gradient(circle at 82% 72%, rgba(133, 245, 222, 0.08), transparent 24rem),
      #050505;
  }

  .public-home {
    display: grid;
    min-height: 100svh;
    place-items: center;
    padding: 92px 18px;
  }

  .public-home__panel {
    display: grid;
    width: min(100%, 720px);
    gap: clamp(28px, 5vw, 48px);
    isolation: isolate;
  }

  .public-home__top,
  .public-home__link {
    font-family: var(--mono-font);
  }

  .public-home__top {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .public-home__eyebrow {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.74rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .public-home__toggle {
    min-height: 36px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    cursor: pointer;
    padding: 0 13px;
    font: inherit;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .public-home__identity {
    display: grid;
    gap: 18px;
    justify-items: start;
  }

  .public-home__title-paint {
    position: relative;
    display: inline-grid;
    width: fit-content;
    max-width: 100%;
    margin-bottom: clamp(12px, 2vw, 24px);
    color: #fff8dc;
    isolation: isolate;
  }

  .public-home__title-art {
    position: absolute;
    z-index: 0;
    top: -25%;
    left: -4%;
    width: 108%;
    height: 172%;
    overflow: visible;
    color: inherit;
    pointer-events: none;
    filter:
      drop-shadow(0 0 1px rgba(255, 255, 255, 0.5))
      drop-shadow(0 0 12px rgba(246, 216, 96, 0.16));
  }

  .public-home h1 {
    position: relative;
    z-index: 1;
    margin: 0;
    color: inherit;
    font-family: var(--mono-font);
    font-size: clamp(3.6rem, 9.5vw, 7.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-shadow:
      0 0 1px rgba(255, 255, 255, 0.95),
      0 0 30px rgba(246, 216, 96, 0.36),
      0 14px 48px rgba(0, 0, 0, 0.9);
  }

  .public-home__email {
    position: relative;
    z-index: 2;
    width: fit-content;
    color: #d9d0b7;
    font-size: clamp(1rem, 2vw, 1.2rem);
  }

  .public-home__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .public-home__links li {
    min-width: 0;
  }

  .public-home__link {
    display: grid;
    width: 100%;
    height: 100%;
    gap: 8px;
    align-content: center;
    justify-items: start;
    min-height: 94px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.035);
    color: inherit;
    cursor: pointer;
    text-align: left;
    padding: 16px;
    transition:
      border-color 180ms ease,
      transform 180ms ease,
      background 180ms ease;
  }

  .public-home__link:hover,
  .public-home__link:focus-visible {
    border-color: rgba(246, 216, 96, 0.58);
    background: rgba(246, 216, 96, 0.07);
    transform: translateY(-2px);
  }

  .public-home__link-heading {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .public-home__link-label {
    color: var(--text);
    font-size: 0.78rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .public-home__copy-state {
    color: var(--yellow);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    opacity: 0;
    text-transform: uppercase;
    transition: opacity 160ms ease;
  }

  .public-home__link:hover .public-home__copy-state,
  .public-home__link:focus-visible .public-home__copy-state,
  .public-home__link[data-copy-state] .public-home__copy-state {
    opacity: 0.82;
  }

  .public-home__value {
    position: relative;
    display: inline-flex;
    max-width: 100%;
  }

  .public-home__value strong {
    overflow-wrap: anywhere;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-weight: 400;
    line-height: 1.35;
  }

  .contact-scribble {
    position: absolute;
    top: 50%;
    left: -10px;
    width: calc(100% + 20px);
    height: 2.45rem;
    overflow: visible;
    pointer-events: none;
    transform: translateY(-50%) rotate(var(--scribble-tilt));
    transform-origin: center;
    opacity: 0.98;
    filter: drop-shadow(0 0 3px rgba(246, 216, 96, 0.28));
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .contact-scribble path {
    fill: none;
    stroke: #f6d860;
    stroke-width: 2.94;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .public-home__link:hover .contact-scribble,
  .public-home__link:focus-visible .contact-scribble,
  .public-home__link[data-copy-state] .contact-scribble,
  :global(html.construction-hidden) .contact-scribble {
    opacity: 0;
    transform: translateY(-50%) rotate(var(--scribble-tilt)) scaleX(0.96);
  }

  :global(html.construction-hidden) .contact-scribble {
    visibility: hidden;
  }

  @media (max-width: 680px) {
    .public-home {
      align-items: center;
      padding: 76px 14px 82px;
    }

    .public-home__panel {
      gap: 28px;
    }

    .public-home__identity {
      gap: 12px;
    }

    .public-home h1 {
      max-width: 100%;
      font-size: clamp(2.8rem, 13vw, 4.4rem);
      line-height: 1;
    }

    .public-home__email {
      max-width: 100%;
      overflow-wrap: anywhere;
      font-size: 1rem;
    }

    .public-home__links {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .public-home__link {
      min-height: 72px;
      padding: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .public-home__link,
    .public-home__copy-state,
    .contact-scribble {
      transition: none;
    }
  }

  @media (max-width: 380px) {
    .public-home {
      padding-inline: 12px;
    }

    .public-home h1 {
      font-size: clamp(2.45rem, 12vw, 3.6rem);
    }
  }
</style>
