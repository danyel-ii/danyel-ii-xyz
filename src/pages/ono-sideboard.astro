---
const waitlistEndpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT ?? import.meta.env.VITE_WAITLIST_ENDPOINT ?? ''
const pageUrl = 'https://danyel-ii.xyz/ono-sideboard'
const supportBase = 'https://tarot.danyel-ii.xyz'
const supportEmail = 'support@danyel-ii.xyz'
const mailtoHref = `mailto:${supportEmail}?subject=Ono%20Sideboard%20whitelist`

const legalLinks = [
  { label: 'Privacy', href: `${supportBase}/privacy` },
  { label: 'Terms', href: `${supportBase}/terms` },
  { label: 'Support', href: `${supportBase}/support` },
]

const deckPreviews = [
  {
    deckId: 'gold-leaf',
    title: 'Gold Leaf',
    src: '/images/ono-sideboard/deck-previews/gold-leaf.jpg',
    alt: 'Preview card from the Gold Leaf deck in Ono Sideboard.',
  },
  {
    deckId: 'encryptas',
    title: 'Encryptas',
    src: '/images/ono-sideboard/deck-previews/encryptas.jpg',
    alt: 'Preview card from the Encryptas deck in Ono Sideboard.',
  },
  {
    deckId: 'marta',
    title: 'Marta',
    src: '/images/ono-sideboard/deck-previews/marta.jpg',
    alt: 'Preview card from the Marta deck in Ono Sideboard.',
  },
  {
    deckId: 'sgt-pepper',
    title: 'Sgt Pepper',
    src: '/images/ono-sideboard/deck-previews/sgt-pepper.jpg',
    alt: 'Preview card from the Sgt Pepper deck in Ono Sideboard.',
  },
  {
    deckId: 'quatre-gats',
    title: 'Quatre Gats',
    src: '/images/ono-sideboard/deck-previews/quatre-gats.jpg',
    alt: 'Preview card from the Quatre Gats deck in Ono Sideboard.',
  },
]

const initialDeckPreview = deckPreviews[0]

const features = [
  ['Read', 'Daily cards and spreads.'],
  ['Remember', 'Private notes and patterns.'],
  ['Create', 'Decks from your references.'],
  ['Reflect', 'Optional AI prompts.'],
]

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ono Sideboard',
  operatingSystem: 'Android',
  applicationCategory: 'LifestyleApplication',
  description: 'A private tarot journal and custom deck creator for Android.',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ono Sideboard - Whitelist Invitation</title>
    <meta
      name="description"
      content="Join the Ono Sideboard whitelist. A private tarot journal and custom deck creator for Android."
    />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#100d18" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/images/ono-sideboard/logo-favicon.png" />
    <link rel="apple-touch-icon" href="/images/ono-sideboard/logo-touch.png" />
    <meta property="og:title" content="Ono Sideboard - Whitelist Invitation" />
    <meta property="og:description" content="A private tarot journal and custom deck creator for Android." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://danyel-ii.xyz/images/ono-sideboard/splash.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>
  <body>
    <div class="ono-page">
      <header class="ono-header" aria-label="Ono Sideboard">
        <a class="ono-brand" href="/ono-sideboard" aria-label="Ono Sideboard home">
          <img src="/images/ono-sideboard/logo.jpg" alt="" width="52" height="52" />
          <span>Ono Sideboard</span>
        </a>
        <nav class="ono-nav" aria-label="Page links">
          <a href="#whitelist">Whitelist</a>
          <a href="#decks">Decks</a>
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="ono-title">
          <div class="hero__copy">
            <img class="hero__logo" src="/images/ono-sideboard/logo.jpg" alt="Ono Sideboard logo" width="160" height="160" />
            <p class="eyebrow">Whitelist invitation</p>
            <h1 id="ono-title">Ono Sideboard</h1>
            <p class="lede">
              Private tarot journaling. Custom decks. Early Android access.
            </p>
            <div class="actions">
              <a class="button" href="#whitelist">Join the whitelist</a>
              <a class="button button--ghost" href={`${supportBase}/privacy`}>Privacy</a>
            </div>
          </div>

          <figure class="splash">
            <img
              src="/images/ono-sideboard/splash.jpg"
              alt="Ono Sideboard splash artwork with tarot symbols, mountains, and a winding river."
              width="733"
              height="1100"
              loading="eager"
              decoding="async"
            />
          </figure>
        </section>

        <section id="whitelist" class="panel whitelist" aria-labelledby="whitelist-title">
          <div>
            <p class="eyebrow">Whitelist</p>
            <h2 id="whitelist-title">Join the whitelist.</h2>
            <p>
              One email when early access opens. No noise.
            </p>
          </div>

          <form class="whitelist-form" data-endpoint={waitlistEndpoint} data-mailto={mailtoHref} novalidate>
            <label>
              <span>Email address</span>
              <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </label>
            <button class="button" type="submit">Join the whitelist</button>
            <p class="whitelist-form__message" role="status" aria-live="polite">
              No whitelist endpoint is configured yet. Submitting will open an email to support.
            </p>
            <!-- TODO: Wire this form to a production whitelist endpoint when email compliance and deletion workflow are ready. -->
          </form>
        </section>

        <section id="decks" class="deck-section" aria-labelledby="decks-title">
          <div class="section-intro">
            <p class="eyebrow">Deck rotation</p>
            <h2 id="decks-title">A different deck on each refresh.</h2>
            <p class="deck-section__note" data-deck-note>Showing a preview from {initialDeckPreview.title}.</p>
          </div>
          <div class="deck-strip deck-strip--single" data-random-deck>
            <figure class="deck-card deck-card--featured">
              <img
                src={initialDeckPreview.src}
                alt={initialDeckPreview.alt}
                width="371"
                height="620"
                loading="lazy"
                decoding="async"
              />
              <figcaption>{initialDeckPreview.title}</figcaption>
            </figure>
          </div>
        </section>

        <section class="feature-grid" aria-label="Ono Sideboard features">
          {features.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </section>
      </main>

      <footer class="ono-footer">
        <nav aria-label="Footer">
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={`${supportBase}/account/delete`}>Account deletion</a>
          <a href={`mailto:${supportEmail}`}>Contact</a>
        </nav>
        <p>
          &copy; 2026 Daniel Hawes. Ono Sideboard is for reflection and creative journaling. It is not medical, legal, financial, or mental-health advice.
        </p>
      </footer>
    </div>

    <script type="application/json" id="ono-deck-pool" set:html={JSON.stringify(deckPreviews)} />
    <script>
      const deckPoolElement = document.querySelector('#ono-deck-pool')
      const deckStage = document.querySelector('[data-random-deck]')
      const deckNote = document.querySelector('[data-deck-note]')
      const form = document.querySelector('.whitelist-form')

      if (deckPoolElement && deckStage instanceof HTMLElement) {
        try {
          const decks = JSON.parse(deckPoolElement.textContent || '[]')
          const storageKey = 'ono-sideboard-last-preview-deck'
          const lastDeckId = window.localStorage?.getItem(storageKey)
          const candidates = decks.filter((deck) => deck.deckId !== lastDeckId)
          const previewPool = candidates.length ? candidates : decks
          const selectedDeck = previewPool[Math.floor(Math.random() * previewPool.length)]
          const image = deckStage.querySelector('img')
          const caption = deckStage.querySelector('figcaption')

          if (selectedDeck && image instanceof HTMLImageElement && caption) {
            image.src = selectedDeck.src
            image.alt = selectedDeck.alt
            caption.textContent = selectedDeck.title

            if (deckNote) {
              deckNote.textContent = `Showing a preview from ${selectedDeck.title}.`
            }

            window.localStorage?.setItem(storageKey, selectedDeck.deckId)
          }
        } catch {
          // Keep the server-rendered fallback deck if the pool cannot be parsed.
        }
      }

      if (form instanceof HTMLFormElement) {
        const message = form.querySelector('.whitelist-form__message')
        const button = form.querySelector('button[type="submit"]')
        const endpoint = form.dataset.endpoint || ''
        const mailto = form.dataset.mailto || 'mailto:support@danyel-ii.xyz'
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

        form.addEventListener('submit', async (event) => {
          event.preventDefault()
          const formData = new FormData(form)
          const email = String(formData.get('email') || '').trim().toLowerCase()

          if (!message || !(button instanceof HTMLButtonElement)) return

          if (!emailPattern.test(email)) {
            message.textContent = 'Enter a valid email address before joining the whitelist.'
            return
          }

          if (!endpoint) {
            message.textContent = 'Opening your email app so you can ask to join the whitelist.'
            window.location.href = `${mailto}&body=${encodeURIComponent(`Please add ${email} to the Ono Sideboard whitelist.`)}`
            return
          }

          button.disabled = true
          button.textContent = 'Joining...'
          message.textContent = 'Submitting your whitelist request.'

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, interestType: 'both', source: 'whitelist-invitation' }),
            })
            const data = await response.json().catch(() => ({}))

            if (!response.ok) {
              throw new Error(data?.status === 'already_joined' ? 'already_joined' : 'error')
            }

            message.textContent = data?.status === 'already_joined'
              ? 'You are already on the Ono Sideboard whitelist.'
              : 'You are on the Ono Sideboard whitelist.'
            form.reset()
          } catch (error) {
            message.textContent = error instanceof Error && error.message === 'already_joined'
              ? 'You are already on the Ono Sideboard whitelist.'
              : 'The whitelist request could not be saved. You can contact support@danyel-ii.xyz instead.'
          } finally {
            button.disabled = false
            button.textContent = 'Join the whitelist'
          }
        })
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #100d18;
    --bg-soft: #171320;
    --panel: rgba(255, 248, 232, 0.08);
    --panel-strong: rgba(255, 248, 232, 0.13);
    --text: #fff7e8;
    --muted: #c8bfae;
    --gold: #d8b76a;
    --rose: #d99a8f;
    --violet: #8f7bd9;
    --ink: #0c0912;
    --line: rgba(255, 247, 232, 0.16);
    --success: #b9e6c9;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    background:
      radial-gradient(circle at 17% 8%, rgba(216, 183, 106, 0.18), transparent 28rem),
      radial-gradient(circle at 76% 18%, rgba(143, 123, 217, 0.16), transparent 30rem),
      linear-gradient(180deg, var(--bg), #0b0810 72%, var(--ink));
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body:before {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(255, 247, 232, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 247, 232, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    content: "";
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .ono-page {
    width: min(100% - 32px, 1160px);
    margin: 0 auto;
  }

  .ono-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 0;
    background: linear-gradient(180deg, rgba(16, 13, 24, 0.94), rgba(16, 13, 24, 0.72));
    backdrop-filter: blur(14px);
  }

  .ono-brand,
  .ono-nav,
  .eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  .ono-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .ono-brand img {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
  }

  .ono-nav,
  .ono-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .ono-nav a,
  .ono-footer a {
    border-bottom: 1px solid transparent;
  }

  .ono-nav a:hover,
  .ono-footer a:hover {
    border-bottom-color: currentColor;
  }

  main {
    display: grid;
    gap: 72px;
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(330px, 0.82fr);
    gap: 56px;
    align-items: center;
    min-height: 720px;
    padding: 60px 0 18px;
  }

  .hero__copy,
  .section-intro,
  .panel {
    display: grid;
    gap: 18px;
  }

  .hero__logo {
    width: 112px;
    height: 112px;
    border: 1px solid rgba(216, 183, 106, 0.34);
    border-radius: 18px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
    object-fit: cover;
  }

  .eyebrow {
    margin: 0;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2 {
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: 0;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 8vw, 6.6rem);
    line-height: 0.9;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  h3 {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  p,
  li {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .lede {
    max-width: 54ch;
    color: #eee2cd;
    font-size: 1.12rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid var(--gold);
    border-radius: 6px;
    background: var(--gold);
    color: var(--ink);
    cursor: pointer;
    font-weight: 700;
  }

  .button--ghost {
    background: rgba(255, 248, 232, 0.04);
    color: var(--text);
  }

  .button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .splash {
    position: relative;
    width: min(390px, 100%);
    aspect-ratio: 2 / 3;
    justify-self: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(216, 183, 106, 0.44);
    border-radius: 8px;
    background: var(--panel);
    box-shadow:
      0 46px 120px rgba(0, 0, 0, 0.48),
      0 0 0 10px rgba(255, 248, 232, 0.04),
      0 0 100px rgba(216, 183, 106, 0.18);
    transform: rotate(1deg);
  }

  .splash:before {
    position: absolute;
    inset: -24%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(216, 183, 106, 0.32), transparent 58%);
    content: "";
    filter: blur(14px);
  }

  .splash img,
  .deck-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel,
  .feature-grid article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22);
  }

  .whitelist {
    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
    align-items: start;
    padding: 28px;
    background: var(--panel-strong);
  }

  .whitelist-form {
    display: grid;
    gap: 14px;
  }

  .whitelist-form label {
    display: grid;
    gap: 8px;
    color: var(--text);
    font-weight: 700;
  }

  .whitelist-form input {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(12, 9, 18, 0.86);
    color: var(--text);
    padding: 0 12px;
  }

  .whitelist-form__message {
    min-height: 1.7em;
    color: var(--success);
    font-size: 0.92rem;
  }

  .deck-section {
    display: grid;
    gap: 28px;
  }

  .deck-section__note {
    max-width: 34ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .deck-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    align-items: end;
  }

  .deck-strip--single {
    grid-template-columns: minmax(220px, 340px);
    justify-content: center;
  }

  .deck-card {
    display: grid;
    gap: 12px;
    margin: 0;
  }

  .deck-card img {
    aspect-ratio: 3 / 5;
    border: 1px solid rgba(216, 183, 106, 0.38);
    border-radius: 7px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.34);
  }

  .deck-card:nth-child(2),
  .deck-card:nth-child(4) {
    transform: translateY(28px);
  }

  .deck-strip--single .deck-card {
    transform: none;
  }

  .deck-card figcaption {
    color: var(--muted);
    font-size: 0.9rem;
    text-align: center;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }

  .feature-grid article {
    min-height: 150px;
    padding: 20px;
  }

  .feature-grid h3 {
    margin-bottom: 10px;
  }

  .ono-footer {
    display: grid;
    gap: 16px;
    padding: 20px 0 38px;
  }

  .ono-footer p {
    max-width: 76ch;
    font-size: 0.94rem;
  }

  @media (max-width: 1023px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
      padding-top: 42px;
    }

    .splash {
      width: min(340px, 88%);
      transform: none;
    }

    .feature-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 767px) {
    .ono-page {
      width: min(100% - 24px, 1160px);
    }

    .ono-header {
      align-items: center;
      flex-direction: row;
      position: static;
      padding: 12px 0 8px;
    }

    .ono-nav {
      justify-content: flex-start;
      gap: 10px;
      font-size: 0.76rem;
    }

    .ono-nav a:nth-child(n + 3) {
      display: none;
    }

    .ono-brand {
      gap: 8px;
    }

    .ono-brand img {
      width: 34px;
      height: 34px;
      border-radius: 7px;
    }

    .ono-brand span {
      max-width: 9ch;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    main {
      gap: 42px;
    }

    .hero {
      gap: 22px;
      padding-top: 18px;
    }

    .splash {
      order: 1;
      width: min(285px, 78vw);
      box-shadow:
        0 34px 90px rgba(0, 0, 0, 0.48),
        0 0 0 8px rgba(255, 248, 232, 0.035),
        0 0 80px rgba(216, 183, 106, 0.16);
    }

    .hero__copy {
      order: 2;
      gap: 12px;
      justify-items: start;
    }

    .hero__logo {
      display: none;
    }

    .eyebrow {
      font-size: 0.68rem;
      letter-spacing: 0.1em;
    }

    h1 {
      max-width: 100%;
      font-size: clamp(3rem, 17vw, 4.9rem);
      line-height: 0.86;
    }

    h2 {
      max-width: 11ch;
      font-size: clamp(2rem, 10vw, 2.7rem);
    }

    .lede {
      max-width: 28ch;
      font-size: 1rem;
      line-height: 1.45;
    }

    .actions,
    .actions .button,
    .whitelist-form .button {
      width: 100%;
    }

    .whitelist,
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .whitelist {
      gap: 16px;
      padding: 18px;
    }

    .whitelist p {
      font-size: 0.94rem;
      line-height: 1.45;
    }

    .whitelist-form {
      gap: 10px;
    }

    .whitelist-form label span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .whitelist-form__message {
      min-height: auto;
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .deck-section {
      gap: 16px;
    }

    .deck-section .section-intro {
      gap: 10px;
    }

    .deck-section__note {
      max-width: 28ch;
      font-size: 0.9rem;
    }

    .deck-strip {
      display: flex;
      width: calc(100% + 24px);
      margin: 0 -12px;
      padding: 4px 12px 18px;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .deck-strip--single {
      display: grid;
      width: 100%;
      margin: 0;
      padding: 2px 0 0;
      grid-template-columns: minmax(0, 255px);
      justify-content: center;
      overflow: visible;
    }

    .deck-strip::-webkit-scrollbar {
      display: none;
    }

    .deck-card {
      flex: 0 0 46%;
      min-width: 148px;
      scroll-snap-align: start;
