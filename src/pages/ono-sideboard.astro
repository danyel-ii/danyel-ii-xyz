---
import { existsSync, readFileSync, readdirSync } from 'node:fs'

export const prerender = true

const waitlistEndpoint = '/api/waitlist'
const pageUrl = 'https://danyel-ii.xyz/ono-sideboard'
const shareImageUrl = 'https://danyel-ii.xyz/images/ono-sideboard/social-splash.png'
const shareDescription = 'A private tarot journal for readings, spreads, and custom decks.'
const supportBase = 'https://tarot.danyel-ii.xyz'
const supportEmail = 'support@danyel-ii.xyz'
const deckDirectory = 'public/images/ono-sideboard/decks'

const titleCaseSlug = (slug: string) =>
  slug
    .replace(/\.(jpg|jpeg|png)$/i, '')
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')

const legalLinks = [
  { label: 'Privacy', href: `${supportBase}/privacy` },
  { label: 'Terms', href: `${supportBase}/terms` },
  { label: 'Support', href: `${supportBase}/support` },
]

const appDeckOrder = ['gold-leaf', 'marta', 'quatre-gats', 'sgt-pepper', 'maskless']
const representativeCardSlug = 'the-high-priestess'
const foolCardSlug = 'the-fool'
const fixedPreviewSlugs = ['the-fool', 'seven-of-cups', 'seven-of-wands']
const deckIds = existsSync(deckDirectory)
  ? readdirSync(deckDirectory, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => entry.name)
      .filter((deckId) => appDeckOrder.includes(deckId))
      .sort((left, right) => {
        const leftIndex = appDeckOrder.indexOf(left)
        const rightIndex = appDeckOrder.indexOf(right)

        if (leftIndex === -1 && rightIndex === -1) return left.localeCompare(right)
        if (leftIndex === -1) return 1
        if (rightIndex === -1) return -1
        return leftIndex - rightIndex
      })
  : []

const cardDecks = deckIds
  .map((deckId) => {
    const manifestPath = `${deckDirectory}/${deckId}/deck.json`
    const manifest = existsSync(manifestPath)
      ? JSON.parse(readFileSync(manifestPath, 'utf8'))
      : {}
    const availableCardFiles = readdirSync(`${deckDirectory}/${deckId}`)
      .filter((fileName) => /\.(jpg|jpeg|png)$/i.test(fileName))
      .sort()
    const title = typeof manifest.title === 'string' ? titleCaseSlug(manifest.title) : titleCaseSlug(deckId)
    const manifestCards = Array.isArray(manifest.cards) ? manifest.cards : []
    const cards = manifestCards.length
      ? manifestCards
          .filter((card) => typeof card.image === 'string' && availableCardFiles.includes(card.image))
          .map((card) => ({
            slug: typeof card.slug === 'string' ? card.slug : card.image.replace(/\.(jpg|jpeg|png)$/i, ''),
            title: typeof card.title === 'string' ? card.title : titleCaseSlug(card.image),
            image: card.image,
          }))
      : availableCardFiles.map((fileName) => ({
          slug: fileName.replace(/\.(jpg|jpeg|png)$/i, ''),
          title: titleCaseSlug(fileName),
          image: fileName,
        }))

    const previewPath = `public/images/ono-sideboard/deck-previews/${deckId}.jpg`

    const mappedCards = cards.map((card) => ({
      cardId: `${deckId}:${card.slug}`,
      deckId,
      deckTitle: title,
      slug: card.slug,
      title: card.title,
      src: `/images/ono-sideboard/decks/${deckId}/${card.image}`,
      alt: `${card.title} tarot card from the ${title} deck in Ono Sideboard.`,
    }))

    const representativeCard = mappedCards.find((card) => card.slug === representativeCardSlug) ?? mappedCards[0]

    return {
      deckId,
      title,
      preview: existsSync(previewPath) ? `/images/ono-sideboard/deck-previews/${deckId}.jpg` : '',
      representativeCard,
      cards: mappedCards,
    }
  })
  .filter((deck) => deck.cards.length >= 5)

const representativeDeckCards = cardDecks
  .map((deck) => deck.representativeCard)
  .filter(Boolean)
const heroCardPreviews = representativeDeckCards.slice(0, 3)
const foolPreviewCards = cardDecks
  .map((deck) => deck.cards.find((card) => card.slug === foolCardSlug))
  .filter(Boolean)
const initialFixedPreviewCards = fixedPreviewSlugs
  .map((slug) => cardDecks[0]?.cards.find((card) => card.slug === slug))
  .filter(Boolean)

const featureAreas = [
  {
    icon: 'spark',
    title: 'Tarot journaling',
    body: 'Daily cards, spreads, questions, and reflections become a private journal you can return to over time.',
  },
  {
    icon: 'layers',
    title: 'Custom decks',
    body: 'Create your own tarot decks, then explore complete deck families with the structure of a familiar tarot system.',
  },
  {
    icon: 'lock',
    title: 'Pattern memory',
    body: 'Track recurring cards, themes, and readings without turning a reflective practice into a social feed.',
  },
  {
    icon: 'bot',
    title: 'Optional AI prompts',
    body: 'Guided prompts can help unblock writing while keeping the app centered on your own notes.',
  },
]

const docs = [
  ['Start', 'Open a daily card or spread, write the question, then save the reading into your tarot journal.'],
  ['Decks', 'Browse deck families, create your own decks, preview cards, and keep favorites ready for future readings.'],
  ['Journal', 'Use tags, reflections, and recurring themes to follow what keeps showing up in your readings.'],
  ['Safety', 'Ono Sideboard is for reflection and creative journaling, not medical, legal, financial, or mental-health advice.'],
]

const faqs = [
  ['When will Android access open?', 'The whitelist is for early Android access. We will send one email when the first build is ready.'],
  ['Is the Play Store link live?', 'Not yet. The Android download area is reserved for the public listing and beta download link.'],
  ['Do I need to use AI?', 'No. AI prompts are optional and are treated as a writing aid, not an authority.'],
  ['What do you store for the whitelist?', 'Only the name and email submitted for Ono Sideboard launch updates.'],
]

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ono Sideboard',
  operatingSystem: 'Android',
  applicationCategory: 'LifestyleApplication',
  description: shareDescription,
  image: shareImageUrl,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ono Sideboard - Private Tarot Journal for Android</title>
    <meta name="description" content={`${shareDescription} Join the early access whitelist.`} />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#f4efe4" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/images/ono-sideboard/logo-favicon.png" />
    <link rel="apple-touch-icon" href="/images/ono-sideboard/logo-touch.png" />
    <meta property="og:title" content="Ono Sideboard" />
    <meta property="og:description" content={shareDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={shareImageUrl} />
    <meta property="og:image:secure_url" content={shareImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1536" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:image:alt" content={shareDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Ono Sideboard" />
    <meta name="twitter:description" content={shareDescription} />
    <meta name="twitter:image" content={shareImageUrl} />
    <meta name="twitter:image:alt" content={shareDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>
  <body>
    <svg class="svg-sprite" aria-hidden="true">
      <symbol id="icon-compass" viewBox="0 0 24 24">
        <path d="m8.7 15.3 2.2-4.4 4.4-2.2-2.2 4.4-4.4 2.2Z"></path>
        <circle cx="12" cy="12" r="9"></circle>
      </symbol>
      <symbol id="icon-layers" viewBox="0 0 24 24">
        <path d="m12 3 9 5-9 5-9-5 9-5Z"></path>
        <path d="m3 12 9 5 9-5"></path>
        <path d="m3 16 9 5 9-5"></path>
      </symbol>
      <symbol id="icon-book" viewBox="0 0 24 24">
        <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H7a3 3 0 0 0-3 3V5.5Z"></path>
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
      </symbol>
      <symbol id="icon-help" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M9.7 9a2.5 2.5 0 0 1 4.7 1.2c0 2-2.4 2-2.4 4"></path>
        <path d="M12 18h.01"></path>
      </symbol>
      <symbol id="icon-mail" viewBox="0 0 24 24">
        <path d="M4 6h16v12H4V6Z"></path>
        <path d="m4 7 8 6 8-6"></path>
      </symbol>
      <symbol id="icon-android" viewBox="0 0 24 24">
        <path d="M7 10h10v8a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2v-8Z"></path>
        <path d="M8 10a4 4 0 0 1 8 0"></path>
        <path d="m9 5-1.5-2"></path>
        <path d="M15 5 16.5 3"></path>
        <path d="M10 14h.01"></path>
        <path d="M14 14h.01"></path>
      </symbol>
      <symbol id="icon-spark" viewBox="0 0 24 24">
        <path d="M12 2 9.7 8.7 3 11l6.7 2.3L12 20l2.3-6.7L21 11l-6.7-2.3L12 2Z"></path>
      </symbol>
      <symbol id="icon-lock" viewBox="0 0 24 24">
        <path d="M6 10h12v10H6V10Z"></path>
        <path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10"></path>
      </symbol>
      <symbol id="icon-bot" viewBox="0 0 24 24">
        <path d="M7 9h10a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3v-4a3 3 0 0 1 3-3Z"></path>
        <path d="M12 9V5"></path>
        <path d="M9 14h.01"></path>
        <path d="M15 14h.01"></path>
      </symbol>
      <symbol id="icon-arrow" viewBox="0 0 24 24">
        <path d="M5 12h14"></path>
        <path d="m13 6 6 6-6 6"></path>
      </symbol>
      <symbol id="icon-check" viewBox="0 0 24 24">
        <path d="m5 13 4 4L19 7"></path>
      </symbol>
      <symbol id="icon-close" viewBox="0 0 24 24">
        <path d="M6 6l12 12"></path>
        <path d="M18 6 6 18"></path>
      </symbol>
    </svg>

    <div class="ono-shell">
      <header class="topbar" aria-label="Ono Sideboard">
        <a class="brand" href="/ono-sideboard" aria-label="Ono Sideboard home">
          <img src="/images/ono-sideboard/logo.jpg" alt="" width="44" height="44" />
          <span>Ono Sideboard</span>
        </a>

        <nav class="icon-nav" aria-label="Explore Ono Sideboard">
          <button class="icon-button" type="button" data-panel-target="overview" aria-label="Overview" title="Overview">
            <svg><use href="#icon-compass"></use></svg>
          </button>
          <button class="icon-button is-active" type="button" data-panel-target="decks" aria-label="Decks" title="Decks">
            <svg><use href="#icon-layers"></use></svg>
          </button>
          <button class="icon-button" type="button" data-panel-target="docs" aria-label="Docs" title="Docs">
            <svg><use href="#icon-book"></use></svg>
          </button>
          <button class="icon-button" type="button" data-panel-target="faq" aria-label="FAQ" title="FAQ">
            <svg><use href="#icon-help"></use></svg>
          </button>
        </nav>

        <div class="topbar__actions">
          <a class="icon-link" href="#whitelist" aria-label="Join whitelist" title="Join whitelist">
            <svg><use href="#icon-mail"></use></svg>
          </a>
          <span class="icon-link is-disabled" aria-label="Android download coming soon" title="Android download coming soon">
            <svg><use href="#icon-android"></use></svg>
          </span>
        </div>
      </header>

      <main class="experience">
        <section class="hero" aria-labelledby="ono-title">
          <div class="hero__copy">
            <p class="eyebrow">Android early access</p>
            <h1 id="ono-title">A private tarot journal for readings, spreads, and custom decks.</h1>
            <p class="lede">
              Ono Sideboard is a tarot journaling app: select a deck, record a spread, write the reflection, and watch patterns emerge over time.
            </p>
          </div>

          <div class="hero__media" aria-label="Ono Sideboard app imagery">
            <figure class="phone-frame">
              <img
                src="/images/ono-sideboard/splash.jpg"
                alt="Ono Sideboard app splash artwork."
                width="733"
                height="1100"
                fetchpriority="high"
                decoding="async"
              />
            </figure>
            <div class="card-stack" aria-label="Deck preview cards">
              {heroCardPreviews.map((card) => (
                <figure class="stack-card">
                  <img src={card.src} alt={card.alt} width="371" height="620" loading="eager" decoding="async" />
                </figure>
              ))}
            </div>
          </div>
        </section>

        <section class="control-plane" aria-label="Ono Sideboard product exploration">
          <div class="panel" data-panel="overview" hidden>
            <div class="panel__head">
              <p class="eyebrow">Explore</p>
              <h2>Built for quiet repeat use.</h2>
            </div>
            <div class="feature-grid">
              {featureAreas.map((feature) => (
                <article class="feature">
                  <svg aria-hidden="true"><use href={`#icon-${feature.icon}`}></use></svg>
                  <h3>{feature.title}</h3>
                  <p>{feature.body}</p>
                </article>
              ))}
            </div>
          </div>

          <div class="panel is-active" data-panel="decks">
            <div class="panel__head panel__head--inline">
              <div>
                <p class="eyebrow">Deck system</p>
                <h2>Preview the visual language.</h2>
              </div>
              <p class="deck-note">{cardDecks.length} deck families loaded from the app image library. Create your own decks inside the app.</p>
            </div>
            <div class="deck-browser">
              <div class="deck-list deck-list--five" aria-label="Fool preview cards from available app decks">
                {foolPreviewCards.map((card) => (
                  <button class="deck-choice" type="button" data-preview-deck-id={card.deckId}>
                    <img src={card.src} alt={card.alt} width="371" height="620" loading="lazy" decoding="async" />
                    <span>{card.title}</span>
                  </button>
                ))}
              </div>
              <div class="deck-list deck-list--five" aria-label="High Priestess preview cards from available app decks">
                {representativeDeckCards.map((card) => (
                  <button class="deck-choice" type="button" data-preview-deck-id={card.deckId}>
                    <img src={card.src} alt={card.alt} width="371" height="620" loading="lazy" decoding="async" />
                    <span>{card.title}</span>
                  </button>
                ))}
              </div>
              <div class="deck-stage deck-stage--fixed" data-fixed-preview>
                {initialFixedPreviewCards.map((card) => (
                  <button
                    class="deck-card"
                    type="button"
                    data-card-preview-button
                    data-card-src={card.src}
                    data-card-alt={card.alt}
                    data-card-title={card.title}
                    aria-label={`Open ${card.title} fullscreen preview`}
                  >
                    <img src={card.src} alt={card.alt} width="371" height="620" loading="lazy" decoding="async" />
                    <span class="deck-card__caption">{card.title}</span>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="panel" data-panel="docs" hidden>
            <div class="panel__head">
              <p class="eyebrow">Docs</p>
              <h2>Simple operating notes.</h2>
            </div>
            <div class="docs-list">
              {docs.map(([title, body]) => (
                <article>
                  <span><svg aria-hidden="true"><use href="#icon-check"></use></svg></span>
                  <div>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>

          <div class="panel" data-panel="faq" hidden>
            <div class="panel__head">
              <p class="eyebrow">FAQ</p>
              <h2>Launch details.</h2>
            </div>
            <div class="faq-list">
              {faqs.map(([question, answer]) => (
                <details>
                  <summary>{question}</summary>
                  <p>{answer}</p>
                </details>
              ))}
            </div>
          </div>
        </section>

        <aside id="whitelist" class="signup" aria-labelledby="signup-title">
          <div class="signup__head">
            <p class="eyebrow">Whitelist</p>
            <h2 id="signup-title">Reserve early Android access.</h2>
            <p>One launch email. No campaign drip.</p>
          </div>

          <form class="whitelist-form" data-endpoint={waitlistEndpoint} novalidate>
            <label>
              <span>Name</span>
              <input name="name" type="text" autocomplete="name" placeholder="Name" required />
            </label>
            <label>
              <span>Email address</span>
              <input name="email" type="email" autocomplete="email" placeholder="Email" required />
            </label>
            <label class="whitelist-form__trap" aria-hidden="true">
              <span>Website</span>
              <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
            <button class="submit-button" type="submit" aria-label="Join whitelist">
              <svg aria-hidden="true"><use href="#icon-arrow"></use></svg>
            </button>
            <p class="whitelist-form__message" role="status" aria-live="polite">
              We store your name and email only for Ono Sideboard launch updates.
            </p>
          </form>

          <div class="download-placeholder" aria-label="Android download status">
            <svg aria-hidden="true"><use href="#icon-android"></use></svg>
            <div>
              <strong>Android download</strong>
              <span>Play Store and beta link placeholder.</span>
            </div>
          </div>
        </aside>
      </main>

      <footer class="footer">
        <nav aria-label="Footer">
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={`${supportBase}/account/delete`}>Account deletion</a>
          <a href={`mailto:${supportEmail}`}>Contact</a>
        </nav>
        <p>&copy; 2026 Daniel Hawes. Ono Sideboard is for reflection and creative journaling.</p>
      </footer>
    </div>

    <div class="card-lightbox" data-card-lightbox role="dialog" aria-modal="true" aria-labelledby="card-lightbox-title" hidden>
      <button class="card-lightbox__backdrop" type="button" data-card-lightbox-close aria-label="Close fullscreen card preview"></button>
      <figure class="card-lightbox__figure">
        <button class="card-lightbox__close" type="button" data-card-lightbox-close aria-label="Close fullscreen card preview">
          <svg aria-hidden="true"><use href="#icon-close"></use></svg>
        </button>
        <img data-card-lightbox-image src="" alt="" width="371" height="620" decoding="async" />
        <figcaption id="card-lightbox-title" data-card-lightbox-title></figcaption>
      </figure>
    </div>

    <script type="application/json" id="ono-card-pool" set:html={JSON.stringify(cardDecks)} />
    <script>
      const navButtons = Array.from(document.querySelectorAll('[data-panel-target]'))
      const panels = Array.from(document.querySelectorAll('[data-panel]'))
      const cardPoolElement = document.querySelector('#ono-card-pool')
      const previewButtons = Array.from(document.querySelectorAll('[data-preview-deck-id]'))
      const fixedPreview = document.querySelector('[data-fixed-preview]')
      const lightbox = document.querySelector('[data-card-lightbox]')
      const lightboxImage = document.querySelector('[data-card-lightbox-image]')
      const lightboxTitle = document.querySelector('[data-card-lightbox-title]')
      const lightboxCloseButtons = Array.from(document.querySelectorAll('[data-card-lightbox-close]'))
      const form = document.querySelector('.whitelist-form')
      let lastLightboxTrigger = null

      const showPanel = (panelName) => {
        panels.forEach((panel) => {
          const isActive = panel instanceof HTMLElement && panel.dataset.panel === panelName
          panel.classList.toggle('is-active', isActive)
          if (panel instanceof HTMLElement) panel.hidden = !isActive
        })

        navButtons.forEach((button) => {
          const isActive = button instanceof HTMLElement && button.dataset.panelTarget === panelName
          button.classList.toggle('is-active', isActive)
          button.setAttribute('aria-pressed', String(isActive))
        })
      }

      navButtons.forEach((button) => {
        button.addEventListener('click', () => {
          if (!(button instanceof HTMLElement) || !button.dataset.panelTarget) return
          showPanel(button.dataset.panelTarget)
        })
      })

      if (cardPoolElement && fixedPreview instanceof HTMLElement) {
        try {
          const decks = JSON.parse(cardPoolElement.textContent || '[]')
          const fixedPreviewSlugs = ['the-fool', 'seven-of-cups', 'seven-of-wands']

          const updatePreviewSlot = (slot, card) => {
            const image = slot.querySelector('img')
            const caption = slot.querySelector('.deck-card__caption')
            if (!card || !(slot instanceof HTMLElement) || !(image instanceof HTMLImageElement) || !caption) return

            image.src = card.src
            image.alt = card.alt
            caption.textContent = card.title
            slot.dataset.cardSrc = card.src
            slot.dataset.cardAlt = card.alt
            slot.dataset.cardTitle = card.title
            slot.setAttribute('aria-label', `Open ${card.title} fullscreen preview`)
          }

          const renderFixedPreview = (deckId) => {
            const deck = decks.find((item) => item.deckId === deckId)
            if (!deck || !Array.isArray(deck.cards)) return

            const selectedCards = fixedPreviewSlugs
              .map((slug) => deck.cards.find((card) => card.slug === slug))
              .filter(Boolean)
            const slots = Array.from(fixedPreview.querySelectorAll('.deck-card'))

            slots.forEach((slot, index) => {
              updatePreviewSlot(slot, selectedCards[index])
            })

            previewButtons.forEach((button) => {
              if (!(button instanceof HTMLElement)) return
              button.classList.toggle('is-active', button.dataset.previewDeckId === deckId)
            })
          }

          previewButtons.forEach((button) => {
            button.addEventListener('click', () => {
              if (!(button instanceof HTMLElement) || !button.dataset.previewDeckId) return
              renderFixedPreview(button.dataset.previewDeckId)
            })
          })
        } catch {
          // Keep the server-rendered fallback cards if the deck pool cannot be parsed.
        }
      }

      if (lightbox instanceof HTMLElement && lightboxImage instanceof HTMLImageElement && lightboxTitle) {
        const openLightbox = (button) => {
          const src = button.dataset.cardSrc || ''
          const alt = button.dataset.cardAlt || ''
          const title = button.dataset.cardTitle || ''
          if (!src || !title) return

          lastLightboxTrigger = button
          lightboxImage.src = src
          lightboxImage.alt = alt || title
          lightboxTitle.textContent = title
          lightbox.hidden = false
          document.body.classList.add('is-card-lightbox-open')
          const closeButton = lightbox.querySelector('.card-lightbox__close')
          if (closeButton instanceof HTMLButtonElement) closeButton.focus()
        }

        const closeLightbox = () => {
          if (lightbox.hidden) return
          lightbox.hidden = true
          lightboxImage.removeAttribute('src')
          document.body.classList.remove('is-card-lightbox-open')
          if (lastLightboxTrigger instanceof HTMLButtonElement) lastLightboxTrigger.focus()
        }

        document.querySelectorAll('[data-card-preview-button]').forEach((button) => {
          button.addEventListener('click', () => {
            if (button instanceof HTMLButtonElement) openLightbox(button)
          })
        })

        lightboxCloseButtons.forEach((button) => {
          button.addEventListener('click', closeLightbox)
        })

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') closeLightbox()
        })
      }

      if (form instanceof HTMLFormElement) {
        const message = form.querySelector('.whitelist-form__message')
        const button = form.querySelector('button[type="submit"]')
        const endpoint = form.dataset.endpoint || ''
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

        const setFormState = (state) => {
          form.dataset.state = state
          if (message) message.dataset.state = state
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault()
          const formData = new FormData(form)
          const name = String(formData.get('name') || '').trim().replace(/\s+/g, ' ')
          const email = String(formData.get('email') || '').trim().toLowerCase()
          const website = String(formData.get('website') || '').trim()

          if (!message || !(button instanceof HTMLButtonElement)) return
          setFormState('idle')

          if (!name) {
            setFormState('error')
            message.textContent = 'Enter your name before joining the whitelist.'
            return
          }

          if (!emailPattern.test(email)) {
            setFormState('error')
            message.textContent = 'Enter a valid email address before joining the whitelist.'
            return
          }

          if (!endpoint) {
            setFormState('error')
            message.textContent = 'The whitelist form is temporarily unavailable.'
            return
          }

          setFormState('submitting')
          button.disabled = true
          message.textContent = 'Submitting your whitelist request.'

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name, email, website, source: 'ono-sideboard-whitelist' }),
            })
            const data = await response.json().catch(() => ({}))

            if (!response.ok) throw new Error(data?.status || 'error')

            setFormState('success')
            message.textContent = data?.status === 'updated'
              ? 'Your whitelist details have been updated.'
              : 'You are on the Ono Sideboard whitelist.'
            form.reset()
          } catch (error) {
            setFormState('error')
            if (error instanceof Error && error.message === 'database_not_configured') {
              message.textContent = 'The whitelist database is not configured yet. Please try again later.'
            } else {
              message.textContent = 'The whitelist request could not be saved. Please try again later.'
            }
          } finally {
            button.disabled = false
          }
        })
      }
    </script>
  </body>
</html>

