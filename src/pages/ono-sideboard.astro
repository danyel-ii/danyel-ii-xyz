---
import { existsSync, readFileSync, readdirSync } from 'node:fs'

export const prerender = true
const waitlistEndpoint = '/api/waitlist'
const pageUrl = 'https://danyel-ii.xyz/ono-sideboard'
const supportBase = 'https://tarot.danyel-ii.xyz'
const supportEmail = 'support@danyel-ii.xyz'
const deckDirectory = 'public/images/ono-sideboard/decks'
const titleCaseSlug = (slug: string) =>
  slug
    .replace(/\.(jpg|jpeg|png)$/i, '')
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ')

const legalLinks = [
  { label: 'Privacy', href: `${supportBase}/privacy` },
  { label: 'Terms', href: `${supportBase}/terms` },
  { label: 'Support', href: `${supportBase}/support` },
]

const preferredDeckOrder = ['gold-leaf', 'encryptas', 'marta', 'quatre-gats', 'sgt-pepper', 'maskless']
const deckIds = existsSync(deckDirectory)
  ? readdirSync(deckDirectory, { withFileTypes: true })
      .filter((entry) => entry.isDirectory())
      .map((entry) => entry.name)
      .sort((left, right) => {
        const leftIndex = preferredDeckOrder.indexOf(left)
        const rightIndex = preferredDeckOrder.indexOf(right)

        if (leftIndex === -1 && rightIndex === -1) return left.localeCompare(right)
        if (leftIndex === -1) return 1
        if (rightIndex === -1) return -1
        return leftIndex - rightIndex
      })
  : []

const cardDecks = deckIds
  .map((deckId) => {
    const manifestPath = `${deckDirectory}/${deckId}/deck.json`
    const manifest = existsSync(manifestPath)
      ? JSON.parse(readFileSync(manifestPath, 'utf8'))
      : {}
    const availableCardFiles = readdirSync(`${deckDirectory}/${deckId}`)
      .filter((fileName) => /\.(jpg|jpeg|png)$/i.test(fileName))
      .sort()
    const title = typeof manifest.title === 'string' ? manifest.title : titleCaseSlug(deckId)
    const manifestCards = Array.isArray(manifest.cards) ? manifest.cards : []
    const cards = manifestCards.length
      ? manifestCards
          .filter((card) => typeof card.image === 'string' && availableCardFiles.includes(card.image))
          .map((card) => ({
            slug: typeof card.slug === 'string' ? card.slug : card.image.replace(/\.(jpg|jpeg|png)$/i, ''),
            title: typeof card.title === 'string' ? card.title : titleCaseSlug(card.image),
            image: card.image,
          }))
      : availableCardFiles.map((fileName) => ({
          slug: fileName.replace(/\.(jpg|jpeg|png)$/i, ''),
          title: titleCaseSlug(fileName),
          image: fileName,
        }))

    return {
      deckId,
      title,
      cards: cards.map((card) => {
        return {
          cardId: `${deckId}:${card.slug}`,
          deckId,
          title: card.title,
          src: `/images/ono-sideboard/decks/${deckId}/${card.image}`,
          alt: `${card.title} tarot card from the ${title} deck in Ono Sideboard.`,
        }
      }),
    }
  })
  .filter((deck) => deck.cards.length >= 5)

const initialCardPreviews = cardDecks[0]?.cards.slice(0, 5) ?? []

const features = [
  ['Read', 'Daily cards and spreads.'],
  ['Remember', 'Private notes and patterns.'],
  ['Create', 'Decks from your references.'],
  ['Reflect', 'Optional AI prompts.'],
]

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Ono Sideboard',
  operatingSystem: 'Android',
  applicationCategory: 'LifestyleApplication',
  description: 'A private tarot journal and custom deck creator for Android.',
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ono Sideboard - Whitelist Invitation</title>
    <meta
      name="description"
      content="Join the Ono Sideboard whitelist. A private tarot journal and custom deck creator for Android."
    />
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#100d18" />
    <link rel="canonical" href={pageUrl} />
    <link rel="icon" type="image/png" href="/images/ono-sideboard/logo-favicon.png" />
    <link rel="apple-touch-icon" href="/images/ono-sideboard/logo-touch.png" />
    <meta property="og:title" content="Ono Sideboard - Whitelist Invitation" />
    <meta property="og:description" content="A private tarot journal and custom deck creator for Android." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content="https://danyel-ii.xyz/images/ono-sideboard/splash.jpg" />
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  </head>
  <body>
    <div class="ono-page">
      <header class="ono-header" aria-label="Ono Sideboard">
        <a class="ono-brand" href="/ono-sideboard" aria-label="Ono Sideboard home">
          <img src="/images/ono-sideboard/logo.jpg" alt="" width="52" height="52" />
          <span>Ono Sideboard</span>
        </a>
        <nav class="ono-nav" aria-label="Page links">
          <a href="#whitelist">Whitelist</a>
          <a href="#decks">Decks</a>
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="ono-title">
          <div class="hero__copy">
            <img class="hero__logo" src="/images/ono-sideboard/logo.jpg" alt="Ono Sideboard logo" width="160" height="160" />
            <h1 id="ono-title">Ono Sideboard</h1>
            <p class="lede">
              Private tarot journaling. Custom decks. Early Android access.
            </p>
          </div>
        </section>

        <section id="decks" class="deck-section" aria-label="Ono Sideboard card previews">
          <div class="deck-strip deck-strip--sample" data-random-cards>
            {initialCardPreviews.map((card) => (
              <figure class="deck-card" tabindex="0">
                <img
                  src={card.src}
                  alt={card.alt}
                  width="371"
                  height="620"
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>{card.title}</figcaption>
              </figure>
            ))}
          </div>
        </section>

        <section id="whitelist" class="panel whitelist" aria-labelledby="whitelist-title">
          <div>
            <p class="eyebrow">Whitelist invitation</p>
            <h2 id="whitelist-title">Join the whitelist.</h2>
            <p>
              One email when early access opens. No noise.
            </p>
          </div>

          <form class="whitelist-form" data-endpoint={waitlistEndpoint} novalidate>
            <label>
              <span>Name</span>
              <input name="name" type="text" autocomplete="name" placeholder="Your name" required />
            </label>
            <label>
              <span>Email address</span>
              <input name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
            </label>
            <label class="whitelist-form__trap" aria-hidden="true">
              <span>Website</span>
              <input name="website" type="text" tabindex="-1" autocomplete="off" />
            </label>
            <button class="button" type="submit">Join the whitelist</button>
            <p class="whitelist-form__message" role="status" aria-live="polite">
              We will store your name and email only for Ono Sideboard launch updates.
            </p>
          </form>

          <div class="whitelist-confirmation" data-whitelist-confirmation hidden>
            <p class="eyebrow">Confirmed</p>
            <h3>You're on the whitelist.</h3>
            <p>
              We saved your details. We'll email you when early access opens.
            </p>
          </div>
        </section>

        <section class="splash-section" aria-label="Ono Sideboard splash artwork">
          <figure class="splash">
            <img
              src="/images/ono-sideboard/splash.jpg"
              alt="Ono Sideboard splash artwork with tarot symbols, mountains, and a winding river."
              width="733"
              height="1100"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </section>

        <section class="feature-grid" aria-label="Ono Sideboard features">
          {features.map(([title, body]) => (
            <article>
              <h3>{title}</h3>
              <p>{body}</p>
            </article>
          ))}
        </section>
      </main>

      <footer class="ono-footer">
        <nav aria-label="Footer">
          {legalLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          <a href={`${supportBase}/account/delete`}>Account deletion</a>
          <a href={`mailto:${supportEmail}`}>Contact</a>
        </nav>
        <p>
          &copy; 2026 Daniel Hawes. Ono Sideboard is for reflection and creative journaling. It is not medical, legal, financial, or mental-health advice.
        </p>
      </footer>
    </div>

    <script type="application/json" id="ono-card-pool" set:html={JSON.stringify(cardDecks)} />
    <script>
      const cardPoolElement = document.querySelector('#ono-card-pool')
      const deckStage = document.querySelector('[data-random-cards]')
      const form = document.querySelector('.whitelist-form')

      if (cardPoolElement && deckStage instanceof HTMLElement) {
        try {
          const decks = JSON.parse(cardPoolElement.textContent || '[]')
          const cardsStorageKey = 'ono-sideboard-last-preview-cards'
          const deckStorageKey = 'ono-sideboard-last-preview-deck'
          const lastDeckId = window.localStorage?.getItem(deckStorageKey) || ''
          const parsedCardIds = JSON.parse(window.localStorage?.getItem(cardsStorageKey) || '[]')
          const lastCardIds = Array.isArray(parsedCardIds) ? parsedCardIds : []
          const availableDecks = decks.filter((deck) => Array.isArray(deck.cards) && deck.cards.length >= 5)
          const shuffledDecks = [...availableDecks]

          for (let index = shuffledDecks.length - 1; index > 0; index -= 1) {
            const swapIndex = Math.floor(Math.random() * (index + 1))
            ;[shuffledDecks[index], shuffledDecks[swapIndex]] = [shuffledDecks[swapIndex], shuffledDecks[index]]
          }

          const selectedDeck = shuffledDecks.find((deck) => deck.deckId !== lastDeckId) || shuffledDecks[0]
          if (!selectedDeck) throw new Error('No preview decks are available')

          const shuffledCards = [...selectedDeck.cards]

          for (let index = shuffledCards.length - 1; index > 0; index -= 1) {
            const swapIndex = Math.floor(Math.random() * (index + 1))
            ;[shuffledCards[index], shuffledCards[swapIndex]] = [shuffledCards[swapIndex], shuffledCards[index]]
          }

          const freshCards = shuffledCards.filter((card) => !lastCardIds.includes(card.cardId))
          const selectedCards = [...freshCards, ...shuffledCards.filter((card) => lastCardIds.includes(card.cardId))].slice(0, 5)
          const slots = Array.from(deckStage.querySelectorAll('.deck-card'))

          slots.forEach((slot, index) => {
            const card = selectedCards[index]
            const image = slot.querySelector('img')
            const caption = slot.querySelector('figcaption')

            if (!card || !(image instanceof HTMLImageElement) || !caption) return

            image.src = card.src
            image.alt = card.alt
            caption.textContent = card.title
          })

          window.localStorage?.setItem(deckStorageKey, selectedDeck.deckId)
          window.localStorage?.setItem(cardsStorageKey, JSON.stringify(selectedCards.map((card) => card.cardId)))
        } catch {
          // Keep the server-rendered fallback cards if the pool cannot be parsed.
        }
      }

      if (form instanceof HTMLFormElement) {
        const message = form.querySelector('.whitelist-form__message')
        const button = form.querySelector('button[type="submit"]')
        const confirmation = document.querySelector('[data-whitelist-confirmation]')
        const endpoint = form.dataset.endpoint || ''
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/

        const setFormState = (state) => {
          form.dataset.state = state
          if (message) message.dataset.state = state
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault()
          const formData = new FormData(form)
          const name = String(formData.get('name') || '').trim().replace(/\s+/g, ' ')
          const email = String(formData.get('email') || '').trim().toLowerCase()
          const website = String(formData.get('website') || '').trim()

          if (!message || !(button instanceof HTMLButtonElement)) return
          setFormState('idle')
          if (confirmation instanceof HTMLElement) confirmation.hidden = true

          if (!name) {
            setFormState('error')
            message.textContent = 'Enter your name before joining the whitelist.'
            return
          }

          if (!emailPattern.test(email)) {
            setFormState('error')
            message.textContent = 'Enter a valid email address before joining the whitelist.'
            return
          }

          if (!endpoint) {
            setFormState('error')
            message.textContent = 'The whitelist form is temporarily unavailable.'
            return
          }

          setFormState('submitting')
          button.disabled = true
          button.textContent = 'Joining...'
          message.textContent = 'Submitting your whitelist request.'

          try {
            const response = await fetch(endpoint, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ name, email, website, source: 'ono-sideboard-whitelist' }),
            })
            const data = await response.json().catch(() => ({}))

            if (!response.ok) {
              throw new Error(data?.status || 'error')
            }

            setFormState('success')
            message.textContent = data?.status === 'updated'
              ? 'Your whitelist details have been updated.'
              : 'You are on the Ono Sideboard whitelist.'
            if (confirmation instanceof HTMLElement) confirmation.hidden = false
            form.reset()
          } catch (error) {
            setFormState('error')
            if (error instanceof Error && error.message === 'database_not_configured') {
              message.textContent = 'The whitelist database is not configured yet. Please try again later.'
            } else {
              message.textContent = 'The whitelist request could not be saved. Please try again later.'
            }
          } finally {
            button.disabled = false
            button.textContent = 'Join the whitelist'
          }
        })
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #100d18;
    --bg-soft: #171320;
    --panel: rgba(255, 248, 232, 0.08);
    --panel-strong: rgba(255, 248, 232, 0.13);
    --text: #fff7e8;
    --muted: #c8bfae;
    --gold: #d8b76a;
    --rose: #d99a8f;
    --violet: #8f7bd9;
    --ink: #0c0912;
    --line: rgba(255, 247, 232, 0.16);
    --success: #b9e6c9;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    scroll-behavior: smooth;
  }

  body {
    min-width: 320px;
    margin: 0;
    overflow-x: hidden;
    background:
      radial-gradient(circle at 17% 8%, rgba(216, 183, 106, 0.18), transparent 28rem),
      radial-gradient(circle at 76% 18%, rgba(143, 123, 217, 0.16), transparent 30rem),
      linear-gradient(180deg, var(--bg), #0b0810 72%, var(--ink));
    color: var(--text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  body:before {
    position: fixed;
    inset: 0;
    z-index: -1;
    opacity: 0.2;
    background-image:
      linear-gradient(rgba(255, 247, 232, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 247, 232, 0.025) 1px, transparent 1px);
    background-size: 46px 46px;
    content: "";
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
  }

  a:focus-visible,
  button:focus-visible,
  input:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 4px;
  }

  .ono-page {
    width: min(100% - 32px, 1160px);
    margin: 0 auto;
  }

  .ono-header {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 16px 0;
    background: linear-gradient(180deg, rgba(16, 13, 24, 0.94), rgba(16, 13, 24, 0.72));
    backdrop-filter: blur(14px);
  }

  .ono-brand,
  .ono-nav,
  .eyebrow {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace;
  }

  .ono-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .ono-brand img {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 8px;
    object-fit: cover;
  }

  .ono-nav,
  .ono-footer nav {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .ono-nav a,
  .ono-footer a {
    border-bottom: 1px solid transparent;
  }

  .ono-nav a:hover,
  .ono-footer a:hover {
    border-bottom-color: currentColor;
  }

  main {
    display: grid;
    gap: 56px;
  }

  .hero {
    display: grid;
    justify-items: center;
    padding: 70px 0 0;
    text-align: center;
  }

  .hero__copy,
  .section-intro,
  .panel {
    display: grid;
    gap: 18px;
  }

  .hero__logo {
    justify-self: center;
    width: 112px;
    height: 112px;
    border: 1px solid rgba(216, 183, 106, 0.34);
    border-radius: 18px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.34);
    object-fit: cover;
  }

  .eyebrow {
    margin: 0;
    color: var(--gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2 {
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    letter-spacing: 0;
  }

  h1 {
    max-width: 11ch;
    font-size: clamp(3.2rem, 8vw, 6.6rem);
    line-height: 0.9;
  }

  h2 {
    max-width: 14ch;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  h3 {
    color: var(--text);
    font-size: 1.05rem;
    line-height: 1.3;
  }

  p,
  li {
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.68;
  }

  .lede {
    max-width: 54ch;
    margin: 0 auto;
    color: #eee2cd;
    font-size: 1.12rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    padding: 0 18px;
    border: 1px solid var(--gold);
    border-radius: 6px;
    background: var(--gold);
    color: var(--ink);
    cursor: pointer;
    font-weight: 700;
  }

  .button--ghost {
    background: rgba(255, 248, 232, 0.04);
    color: var(--text);
  }

  .button:disabled {
    cursor: wait;
    opacity: 0.72;
  }

  .splash {
    position: relative;
    width: min(390px, 100%);
    aspect-ratio: 2 / 3;
    justify-self: center;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(216, 183, 106, 0.44);
    border-radius: 8px;
    background: var(--panel);
    box-shadow:
      0 46px 120px rgba(0, 0, 0, 0.48),
      0 0 0 10px rgba(255, 248, 232, 0.04),
      0 0 100px rgba(216, 183, 106, 0.18);
    transform: rotate(1deg);
  }

  .splash-section {
    display: grid;
    justify-items: center;
  }

  .splash:before {
    position: absolute;
    inset: -24%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(216, 183, 106, 0.32), transparent 58%);
    content: "";
    filter: blur(14px);
  }

  .splash img,
  .deck-card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .panel,
  .feature-grid article {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--panel);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22);
  }

  .whitelist {
    grid-template-columns: minmax(0, 0.9fr) minmax(280px, 1fr);
    align-items: start;
    padding: 28px;
    background: var(--panel-strong);
  }

  .whitelist-form {
    display: grid;
    gap: 14px;
  }

  .whitelist-form label {
    display: grid;
    gap: 8px;
    color: var(--text);
    font-weight: 700;
  }

  .whitelist-form input {
    width: 100%;
    min-height: 46px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(12, 9, 18, 0.86);
    color: var(--text);
    padding: 0 12px;
  }

  .whitelist-form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .whitelist-form__message {
    min-height: 1.7em;
    color: var(--success);
    font-size: 0.92rem;
  }

  .whitelist-form__message[data-state="error"] {
    color: #f0b5aa;
  }

  .whitelist-form__message[data-state="submitting"] {
    color: var(--gold);
  }

  .whitelist-confirmation {
    grid-column: 1 / -1;
    display: grid;
    gap: 8px;
    padding: 16px;
    border: 1px solid rgba(185, 230, 201, 0.36);
    border-radius: 8px;
    background: rgba(185, 230, 201, 0.08);
  }

  .whitelist-confirmation[hidden] {
    display: none;
  }

  .whitelist-confirmation h3 {
    font-size: 1.1rem;
  }

  .whitelist-confirmation p:not(.eyebrow) {
    font-size: 0.94rem;
    line-height: 1.45;
  }

  .deck-section {
    display: grid;
    gap: 28px;
  }

  .deck-section__note {
    max-width: 34ch;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .deck-strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    align-items: end;
  }

  .deck-strip--sample {
    grid-template-columns: repeat(5, minmax(0, 178px));
    justify-content: center;
  }

  .deck-card {
    --card-x: 0%;
    --card-y: 0px;
    --card-rotate: 0deg;
    --card-scale: 1;
    position: relative;
    display: grid;
    gap: 12px;
    margin: 0;
    transform: translateX(var(--card-x)) translateY(var(--card-y)) rotate(var(--card-rotate)) scale(var(--card-scale));
    transition:
      transform 180ms ease,
      filter 180ms ease;
    will-change: transform;
  }

  .deck-card:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 6px;
  }

  .deck-card img {
    aspect-ratio: 3 / 5;
    border: 1px solid rgba(216, 183, 106, 0.38);
    border-radius: 7px;
    box-shadow: 0 22px 60px rgba(0, 0, 0, 0.34);
  }

  .deck-card:nth-child(2),
  .deck-card:nth-child(4) {
    --card-y: 28px;
  }

  .deck-strip--sample .deck-card:nth-child(2) {
