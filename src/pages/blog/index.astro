---
export const prerender = true
import SiteLayout from '../../layouts/SiteLayout.astro'
import KnowledgeCard from '../../components/cards/KnowledgeCard.astro'
import SectionEyebrow from '../../components/ui/SectionEyebrow.astro'
import { siteMeta } from '../../data/site'
import {
  getCollectionLabel,
  getEntryHref,
  sortByUpdatedDesc,
  getVisibleCollection,
} from '../../lib/content'

const entries = sortByUpdatedDesc(await getVisibleCollection('blog'))
---

<SiteLayout title={`Blog | ${siteMeta.domain}`} description="Blog posts from danyel-ii.xyz." canonical="/blog/">
  <section class="section-shell content-index">
    <div class="section-shell__intro" data-reveal>
      <SectionEyebrow label="BLOG.LOG // ALL POSTS" />
      <div class="section-shell__heading">
        <h1>Blog posts and progress notes.</h1>
        <p>Newest entries are listed first. Drafts stay visible locally and are excluded from production builds.</p>
      </div>
    </div>
    <div class="knowledge-grid">
      {
        entries.map((entry) => (
          <KnowledgeCard
            href={getEntryHref(entry)}
            kind={getCollectionLabel(entry.collection)}
            title={entry.data.title}
            summary={entry.data.summary}
            updated={entry.data.updated}
            status={entry.data.status}
            topics={entry.data.topics}
          />
        ))
      }
    </div>
  </section>
</SiteLayout>
